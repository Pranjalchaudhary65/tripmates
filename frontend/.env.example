# Copy this file to .env.local (git-ignored) for local development.
# Every VITE_ variable is compiled into the public JavaScript bundle, so
# nothing secret ever belongs in this file.

# Absolute base URL of the backend API, including the /api/v1 prefix and
# without a trailing slash. The dev server must run on the exact origin
# listed in the backend's CORS_ALLOWED_ORIGINS (http://localhost:5173).
VITE_API_BASE_URL=http://localhost:8082/api/v1
