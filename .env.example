# Copy this file to .env and fill in real local values. .env itself is
# git-ignored - never commit it. None of these have defaults baked into
# application.yml on purpose: a missing secret should crash the app on
# startup, not let it limp along against a weak default.

# Postgres container credentials, read by both docker-compose.yml and the
# app's own datasource config. tripmate_app is also the name the append-only
# ledger/audit tables will grant restricted (INSERT/SELECT only) access to
# later - keep it as-is so that migration doesn't need a role rename.
POSTGRES_DB=tripmate
POSTGRES_USER=tripmate_app
POSTGRES_PASSWORD=changeme-local-only

# Redis container password, read by both docker-compose.yml and the app's
# Lettuce client config.
REDIS_PASSWORD=changeme-local-only

# Note: the postgres container's host-side port is mapped to 5433, not the
# default 5432, because this machine may already have a local Postgres
# install listening on 5432. The container's internal port is still 5432 -
# only docker-compose.yml's host-side mapping differs. Connect tools
# (Adminer, psql, a DB client) to localhost:5433.

# Host port the backend listens on. Defaults to 8080 when unset; set it
# when something else on the machine already owns 8080 (an Oracle TNS
# listener commonly does).
SERVER_PORT=8082

# Spring profile(s) to activate on top of the base application.yml. Leave
# blank for plain local dev (app runs on the host, containers expose
# localhost:5433 for Postgres and localhost:6379 for Redis). Set to "docker" only once the backend itself also
# runs inside docker-compose, so it resolves Postgres/Redis by service name
# instead of localhost.
SPRING_PROFILES_ACTIVE=
